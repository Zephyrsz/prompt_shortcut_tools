{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "prompt-shortcut-tools",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-05",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "prompt-shortcut-tools-db",
			"database_id": "508c3404-136a-48e4-a7d4-c607665ef929",
			"migrations_dir": "prisma/d1-migrations"
		},
		{
			"binding": "prompt_shortcut_tools_db",
			"database_name": "prompt-shortcut-tools-db",
			"database_id": "508c3404-136a-48e4-a7d4-c607665ef929",
			"remote": true
		}
	]
}